{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Uji deteksi wajah",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "face_detection.py",
        "--image",
        "sample.jpg",
        "--output",
        "hasil-wajah.png"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Uji estimasi usia dan label",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "age_gender_estimation.py",
        "--image",
        "sample.jpg",
        "--output",
        "hasil-klasifikasi.png"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
